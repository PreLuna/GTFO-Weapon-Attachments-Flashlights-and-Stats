{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PreLuna WeaponAttachments loadouts format 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "CatalogId", "Revision", "Loadouts"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "CatalogId": { "$ref": "#/$defs/id" },
    "Revision": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "Loadouts": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/loadout" } }
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[a-z]", "not": { "pattern": "[^a-z0-9_.-]" }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["Kind"],
      "properties": {
        "Kind": { "enum": ["LocalPlayer", "HostBot"] },
        "BotSlot": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 }
      },
      "if": { "properties": { "Kind": { "const": "HostBot" } } },
      "then": { "required": ["BotSlot"], "properties": { "BotSlot": { "type": "integer" } } },
      "else": { "properties": { "BotSlot": { "type": "null" } } }
    },
    "weapon": {
      "type": "object", "additionalProperties": false, "required": ["DataPackId"],
      "properties": {
        "DataPackId": { "$ref": "#/$defs/id" },
        "OfflineGearId": { "type": ["integer", "null"], "minimum": 1, "maximum": 4294967295 },
        "VariantKey": { "anyOf": [ { "$ref": "#/$defs/id" }, { "type": "null" } ] },
        "ArchetypeId": { "type": ["integer", "null"], "minimum": 1, "maximum": 4294967295 }
      },
      "anyOf": [
        { "required": ["OfflineGearId"], "properties": { "OfflineGearId": { "type": "integer" } } },
        { "required": ["VariantKey"], "properties": { "VariantKey": { "type": "string" } } }
      ]
    },
    "selection": {
      "type": "object", "additionalProperties": false, "required": ["Slot", "AttachmentId"],
      "properties": {
        "Slot": { "enum": ["Muzzle", "Barrel", "Handguard", "FrontGrip", "RearGrip", "Stock", "Magazine", "Ammunition", "Perk", "Optic", "Flashlight"] },
        "AttachmentId": { "$ref": "#/$defs/id" }
      }
    },
    "loadout": {
      "type": "object", "additionalProperties": false, "required": ["Target", "Weapon", "Selections"],
      "properties": {
        "Target": { "$ref": "#/$defs/target" },
        "Weapon": { "$ref": "#/$defs/weapon" },
        "Selections": { "type": "array", "maxItems": 11, "items": { "$ref": "#/$defs/selection" } }
      }
    }
  }
}
